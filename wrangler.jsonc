{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volamidle",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "vo_lam_idle_tn",
      "database_name": "vo-lam-idle-tn",
      "database_id": "d0cd1bf7-2e46-4556-8ea1-fed6125d665d",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_ROOM",
        "class_name": "WorldRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-world-room",
      "new_sqlite_classes": ["WorldRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }

}
