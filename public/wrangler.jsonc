{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volamidle-zip",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
