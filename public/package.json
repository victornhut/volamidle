{
  "name": "volamidle-cloudflare-adapter",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Workers deployment adapter for victornhut/volamidle",
  "scripts": {
    "build:cf": "node scripts/prepare-cloudflare.mjs",
    "dev": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy",
    "check": "node --check worker/src/index.js && node --check scripts/prepare-cloudflare.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
